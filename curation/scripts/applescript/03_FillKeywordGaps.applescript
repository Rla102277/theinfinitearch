-- Infinite Arch: fill keyword gaps so album tiers survive album deletion. ADDS KEYWORDS ONLY.
on tagIt(kw, idText)
	tell application "Photos"
		with timeout of 7200 seconds
			repeat with p in paragraphs of idText
				set u to contents of p
				if u is not "" then
					try
						set m to media item id (u & "/L0/001")
						set kwl to keywords of m
						if kwl is missing value then set kwl to {}
						if kwl does not contain kw then set keywords of m to kwl & {kw}
					end try
				end if
			end repeat
		end timeout
	end tell
end tagIt

tell application "Photos" to activate
