-- Infinite Arch: build TRIPS by LOCATION. Creates albums and adds photos. Deletes nothing.
on fill(albumName, kw, idText)
	tell application "Photos"
		with timeout of 7200 seconds
			if not (exists folder "TRIPS") then make new folder named "TRIPS"
			set topF to folder "TRIPS"
			if exists album albumName of topF then
				set dest to album albumName of topF
			else
				set dest to make new album named albumName at topF
			end if
			set batch to {}
			set allI to {}
			repeat with p in paragraphs of idText
				set u to contents of p
				if u is not "" then
					try
						set m to media item id (u & "/L0/001")
						set kl to keywords of m
						if kl is missing value then set kl to {}
						if kl does not contain kw then set keywords of m to kl & {kw}
						set end of batch to m
						set end of allI to m
					end try
				end if
				if (count of batch) is greater than or equal to 90 then
					add batch to dest
					set batch to {}
				end if
			end repeat
			if (count of batch) > 0 then add batch to dest
			if (count of media items of dest) < (count of allI) then
				set i to 1
				set n to count of allI
				repeat while i ² n
					set j to i + 89
					if j > n then set j to n
					add (items i thru j of allI) to dest
					set i to j + 1
				end repeat
			end if
		end timeout
	end tell
end fill

tell application "Photos" to activate
